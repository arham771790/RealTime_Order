NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realtime_orders
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_RETRY_ATTEMPTS=5
DATABASE_RETRY_DELAY_MS=1000
DATABASE_SSL=false
SOCKET_CORS_ORIGIN=http://localhost:5173
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_REDIS_ADAPTER_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_CHANNEL=order_events
REDIS_RECONNECT_DELAY_MS=1000
REDIS_MAX_RECONNECT_DELAY_MS=30000
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5
EMAIL_ENABLED=false
EMAIL_FROM=orders@example.com
DELIVERED_ORDER_NOTIFICATION_TO=ops@example.com
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=250
EMAIL_CIRCUIT_FAILURE_THRESHOLD=3
EMAIL_CIRCUIT_RESET_TIMEOUT_MS=30000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
