NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realtime_orders
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_RETRY_ATTEMPTS=5
DATABASE_RETRY_DELAY_MS=1000
DATABASE_SSL=false
SOCKET_CORS_ORIGIN=http://localhost:5173
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
REDIS_URL=redis://localhost:6379
REDIS_CHANNEL=order_events
REDIS_RECONNECT_DELAY_MS=1000
REDIS_MAX_RECONNECT_DELAY_MS=30000
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5
